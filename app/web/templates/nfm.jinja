<!DOCTYPE html>
<html lang="de">
<head>
  <title>Aktuelle Nachrichten</title>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
  <meta name="theme-color" content="#000000">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  
  {% if embedded_nfm_css %}
    <style>{{ embedded_nfm_css }}</style>
  {% else %}
    <link rel="stylesheet" href="/static/nfm.css?v={{ app_version }}">
  {% endif %}

  {% if embedded_favicon_ico %}
    <link rel="shortcut icon" href="{{ embedded_favicon_ico }}">
    <link rel="icon" type="image/png" sizes="96x96" href="{{ embedded_favicon_96x96_png }}">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ embedded_apple_touch_icon_png }}">
    {% if deploy_manifest %}
      <link rel="manifest" href="data:application/json;charset=utf-8,{{ embedded_site_webmanifest | urlencode }}">
    {% endif %}
  {% else %}
    <link rel="shortcut icon" href="/static/favicon.ico">
    <link rel="icon" type="image/png" sizes="96x96" href="/static/favicon-96x96.png">
    <link rel="icon" type="image/svg+xml" href="/static/favicon.svg">
    <link rel="apple-touch-icon" sizes="180x180" href="/static/apple-touch-icon.png">
    {% if deploy_manifest %}
      <link rel="manifest" href="/static/manifest.json">
    {% endif %}
  {% endif %}

  {% if embedded_nfm_js %}
    <script>{{ embedded_nfm_js }}</script>
  {% else %}
    <script src="/static/nfm.js?v={{ app_version }}"></script>
  {% endif %}

</head>

<!------------------------------------------------------------------------------------------------------------------->

<body>

  <!-- ========== Render-Progress Banner ========== -->
  {% if data and data.get("render_status") and data["render_status"].get("status") != "done" %}
  <div id="render-progress-banner" data-uid="{{ data.get('uid', '') }}">
    <div class="render-progress-inner">
      <span class="spinner"></span>
      <span class="render-progress-text">Feeds werden analysiert… {{ data["render_status"].get("percent", 0) }}%</span>
      <span class="render-progress-detail">{{ data["render_status"].get("message", "") }}</span>
    </div>
  </div>
  {% endif %}

  <!-- ========== Navigation ========== -->
  <div class="navbar">
    <div class="search-wrap">
      <input type="search" id="search-input" class="search-input"
             placeholder="Suchen…" aria-label="Artikel durchsuchen"
             autocomplete="off" spellcheck="false"
             oninput="handleSearchInput();">
      <span id="search-count" class="search-count" hidden></span>
    </div>
    <a href="#" onclick="event.preventDefault(); filterNewsItems(6);">6h</a>
    <a href="#" onclick="event.preventDefault(); filterNewsItems(12);">12h</a>
    <a href="#" onclick="event.preventDefault(); filterNewsItems(24);">24h</a>
    <a href="#" onclick="event.preventDefault(); filterNewsItems('*');">⭐</a>
    <a href="#" onclick="event.preventDefault(); filterNewsItems('💡');" title="Nur ähnliche Einträge anzeigen">💡</a>
    <a href="#" onclick="event.preventDefault(); cycleSectionVisibility();" title="Darstellung umschalten">💫</a>
    <a href="#" onclick="event.preventDefault(); toggleTheme();" title="Tag/Nachtsicht umschalten">🌙</a>
    <a id="toggle-uninteresting-btn" href="#" onclick="event.preventDefault(); toggleUninterestingVisibility();" title="Uninteressante Einträge einblenden">🚫</a>
    {% if enable_hide_unread %}
      <a href="#" onclick="event.preventDefault(); resetVisitedLinks();" title="Ungelesene zurücksetzen">🧹</a>
    {% endif %}
    <a href="#" onclick="event.preventDefault(); toggleAnleitung();" title="Anleitung anzeigen">📖 Anleitung</a>
    {% if show_settings_ui %}
      <a href="#" onclick="event.preventDefault(); openSettings();" title="Einstellungen">⚙️</a>
    {% endif %}
  </div>

  <div class="main">

    <!-- ========== Header ========== -->
    <div class="header">
      <table>
        <tr>
          <td style="width:20%">
            {% if embedded_favicon_ico %}
              <img src="{{ embedded_favicon_ico }}" width="80">
            {% else %}
              <img src="/static/favicon.png" width="80">
            {% endif %}
          </td>
          <td>
            <p>
              {{data["date"]}}
              <span id="dynamic-stats">
                <br>{{data["new_entries"]}} neue Einträge in {{data["hours_back"]}}h
                {% if data["n_highlighted"] %}
                  <br>{{data["n_highlighted"]}} Einträge mit ⭐
                {% endif %}
                {% if data["n_ml_tagged"] %}
                  <br>{{data["n_ml_tagged"]}} Einträge mit 💡
                {% endif %}
              </span>
              {% if data["n_filtered"] %}
                <br>{{data["n_filtered"]}} Einträge gefiltert
              {% endif %}
              <span id="uninteresting-stats"></span>
            </p>
          </td>
        </tr>
      </table>
    </div>

    <!-- ========== Macros for News Entries ========== -->
    {% macro render_duplicate(dup) %}
      <div class="news-item-dub">
        <span class="label-dub source">{{dup.source}}</span>
        <a href="{{dup.link}}" onclick="clickFollow(event, this)" class="news-title-dub">{{dup.title}}</a>
      </div>
    {% endmacro %}

    {% macro render_news_item(entry, data) %}
      {% if not entry.is_duplicate %}
        <div class="news-item{% if entry.lid in uninteresting_lids %} uninteresting{% endif %}{% if entry.is_ml_tagged %} ml-tagged{% endif %}">
          <a href="{{entry.link}}" onclick="trackClickFollow(event, this, '{{entry.lid}}', 1)" class="news-title">{% if entry.is_ml_tagged %}💡 {% endif %}{{entry.title}}</a>
          <span class="star-rating" data-lid="{{entry.lid}}" title="Artikel mit Sternen bewerten">
            <span class="star" data-val="1" onclick="rateStar(event, this, '{{entry.lid}}')">☆</span>
            <span class="star" data-val="2" onclick="rateStar(event, this, '{{entry.lid}}')">☆</span>
            <span class="star" data-val="3" onclick="rateStar(event, this, '{{entry.lid}}')">☆</span>
            <span class="star" data-val="4" onclick="rateStar(event, this, '{{entry.lid}}')">☆</span>
            <span class="star" data-val="5" onclick="rateStar(event, this, '{{entry.lid}}')">☆</span>
          </span>
          <br>
          <span class="label source">{{entry.source}}</span>
          <span class="label topic">{{entry.topic}}</span>
          <span class="label hours">{{entry.hours_ago}}h</span>
          {% if entry.is_ml_tagged %}<span class="label highlight ml-badge">{{entry.ml_score_pct}}%</span>{% endif %}
          <p class="news-description">{{entry.description}}</p>
          {% for lid in entry.duplicates %}
            {{ render_duplicate(data["by_lid"][lid]) }}
          {% endfor %}
        </div>
      {% endif %}
    {% endmacro %}

    {% macro render_topic_news_item(entry, data) %}
      {% if not entry.is_duplicate %}
        <div class="news-item{% if entry.lid in uninteresting_lids %} uninteresting{% endif %}{% if entry.is_ml_tagged %} ml-tagged{% endif %}">
          <a href="{{entry.link}}" onclick="trackClickFollow(event, this, '{{entry.lid}}', 1)" class="news-title">{% if entry.is_ml_tagged %}💡 {% endif %}{{entry.title}}</a>
          <span class="star-rating" data-lid="{{entry.lid}}" title="Artikel mit Sternen bewerten">
            <span class="star" data-val="1" onclick="rateStar(event, this, '{{entry.lid}}')">☆</span>
            <span class="star" data-val="2" onclick="rateStar(event, this, '{{entry.lid}}')">☆</span>
            <span class="star" data-val="3" onclick="rateStar(event, this, '{{entry.lid}}')">☆</span>
            <span class="star" data-val="4" onclick="rateStar(event, this, '{{entry.lid}}')">☆</span>
            <span class="star" data-val="5" onclick="rateStar(event, this, '{{entry.lid}}')">☆</span>
          </span>
          <br>
          <span class="label topic">{{entry.topic}}</span>
          <span class="label hours">{{entry.hours_ago}}h</span>
          <span class="label source">{{entry.source}}</span>
          {% if entry.is_ml_tagged %}<span class="label highlight ml-badge">{{entry.ml_score_pct}}%</span>{% endif %}
          <p class="news-description">{{entry.description}}</p>
          {% for lid in entry.duplicates %}
            {{ render_duplicate(data["by_lid"][lid]) }}
          {% endfor %}
        </div>
      {% endif %}
    {% endmacro %}

    <!-- ========== Breaking News (Eilmeldungen) Section ========== -->
    <div class="separator" id="eilmeldungen-separator">🚨 Eilmeldungen</div>

    <div id="eilmeldungen-section">
    {% for breaking_topic, entries in (data.get("by_breaking") or {}).items() %}
    {% set non_duplicate_entries = entries|rejectattr('is_duplicate')|list %}
    {% if non_duplicate_entries|length > 0 %}
    <details data-storage-key="{{ breaking_topic }}">
      <summary>🚨 {{breaking_topic}} <span class="entry-length">[{{ non_duplicate_entries|length }}]</span></summary>
      <hr>
      {% for entry in entries %}
        {{ render_topic_news_item(entry, data) }}
      {% endfor %}
      {% if enable_hide_unread %}
      <div style="text-align: center; margin: 20px 0;">
        <button class="button mark-as-read-btn" type="button"
                onclick="hideUninterestingItems(event, '{{ breaking_topic }}', 'topic', this)">
          🗑️ Ungelesene ausblenden
        </button>
      </div>
      {% endif %}
    </details>
    {% endif %}
    {% endfor %}
    </div>

    <!-- ========== Sources Section ========== -->
    <div class="separator" id="sources-separator">Quellen</div>

    <div id="sources-section">
    {% for feed_source, entries in data["by_source"].items() %}
    {% set non_duplicate_entries = entries|rejectattr('is_duplicate')|list %}
    {% if non_duplicate_entries|length > 0 %}
    <details data-storage-key="{{feed_source}}">
      <summary>
        {{feed_source}} <span class="entry-length">[{{ non_duplicate_entries|length }}]</span>
        {% if data.get("source_descriptions", {}).get(feed_source) %}
        <div class="source-description">{{ data["source_descriptions"][feed_source] }}</div>
        {% endif %}
      </summary>
      <hr>
      {% for entry in entries %}
        {{ render_news_item(entry, data) }}
      {% endfor %}
      {% if enable_hide_unread %}
      <div style="text-align: center; margin: 20px 0;">
        <button class="button mark-as-read-btn" type="button" 
                onclick="hideUninterestingItems(event, '{{feed_source}}', 'source', this)">
          🗑️ Ungelesene ausblenden
        </button>
      </div>
      {% endif %}
    </details>
    {% endif %}
    {% endfor %}
    </div>

    <!-- ========== Topics Section ========== -->
    <div class="separator" id="topics-separator">Themen</div>

    <div id="topics-section">
    {% for feed_topic, entries in data["by_topic"].items() %}
    {% set non_duplicate_entries = entries|rejectattr('is_duplicate')|list %}
    {% if non_duplicate_entries|length > 0 %}
    <details data-storage-key="{{feed_topic}}">
      <summary>{{feed_topic}} <span class="entry-length">[{{ non_duplicate_entries|length }}]</span></summary>
      <hr>
      {% for entry in entries %}
        {{ render_topic_news_item(entry, data) }}
      {% endfor %}
      {% if enable_hide_unread %}
      <div style="text-align: center; margin: 20px 0;">
        <button class="button mark-as-read-btn" type="button" 
                onclick="hideUninterestingItems(event, '{{feed_topic}}', 'topic', this)">
          🗑️ Ungelesene ausblenden
        </button>
      </div>
      {% endif %}
    </details>
    {% endif %}
    {% endfor %}
    </div>

    <div class="version-info">v{{ app_version }}</div>

  </div>

  <!-- ========== Anleitung Overlay ========== -->
  <div id="anleitung-overlay" class="settings-overlay" hidden>
    <div class="settings-panel">
      <div class="settings-header">
        <span>📖 Anleitung — NFM News Feed Manager</span>
        <button type="button" class="settings-close" onclick="closeAnleitung();" title="Schließen">×</button>
      </div>
      <div id="anleitung-content" class="settings-anleitung-content">
        <h3>Was macht diese App?</h3>
        <p>NFM (News Feed Manager) ist ein selbst gehosteter RSS-Newsreader: Er lädt deine Feeds asynchron, entfernt Duplikate, filtert nach deinen Einstellungen und stellt die Artikel übersichtlich dar. Es gibt keine Datenbank — der ganze Zustand liegt in JSON/JSONL-Dateien.</p>

        <h3>Die drei Ansichten (💫-Knopf)</h3>
        <p>Der Knopf <strong>💫</strong> schaltet zwischen vier Ansichten um: <strong>Alle</strong> → <strong>Quellen</strong> → <strong>Themen</strong> → <strong>Eilmeldungen</strong> → wieder Alle. Bei „Alle“ werden Quellen, Themen und Eilmeldungen untereinander angezeigt.</p>

        <h3>Artikel-Ansicht &amp; Filter</h3>
        <ul>
          <li><strong>Suche</strong>: Filtert live nach Titel oder Beschreibung.</li>
          <li><strong>6h / 12h / 24h</strong> – Zeitfenster: nur Artikel, die nicht älter als 6/12/24 Stunden sind.</li>
          <li><strong>⭐</strong> – nur hervorgehobene Artikel (Titel enthält ein hervorgehobenes Schlagwort aus den Einstellungen).</li>
          <li><strong>💡</strong> – nur ML-getaggte / „ähnliche“ Einträge (KI-Modell bewertet Ähnlichkeit zu deinen Interessen).</li>
          <li><strong>🚫</strong> – blendet als „uninteressant“ markierte Artikel wieder ein/aus.</li>
          <li><strong>🧹</strong> – setzt alle „gelesen“-Markierungen zurück.</li>
          <li><strong>🌙</strong> – Tag-/Nachtsicht umschalten.</li>
        </ul>

        <h3>Warum wird ein Artikel angezeigt (nicht angezeigt)?</h3>
        <p>Ein Artikel erscheint, wenn er im gewählten Zeitfenster liegt, nicht auf einer Blacklist steht, nicht hinter einer erkannten Paywall ist und kein Duplikat eines anderen Artikels ist. Duplikate mehrerer Quellen zur selben Meldung werden gebündelt; die „Haupt“-Quelle (nach deiner Quellenreihenfolge) bleibt sichtbar, die übrigen werden als eingeklappte Duplikate darunter angezeigt.</p>

        <h3>„Als gelesen markieren“ / „Ungelesene ausblenden“</h3>
        <ul>
          <li><strong>Gelesen</strong>: Ein Klick auf einen Artikel markiert ihn (in deinem Browser) als besucht; er wird ausgegraut.</li>
          <li><strong>🗑️ Ungelesene ausblenden</strong> (je Abschnitt): Erfasst alle noch ungelesenen Artikel des Abschnitts, blendet sie aus und speichert sie als „uninteressant“ — das KI-Modell lernt daraus.</li>
        </ul>

        <h3>Einstellungen (⚙️)</h3>
        <p>Unter <strong>⚙️</strong> steuerst du Empfang (Web-Ansicht / E-Mail-Digest), hervorgehobene Schlagwörter, Blacklists, E-Mail-Empfänger, Quellenreihenfolge, Feeds und globale Werte (z.&nbsp;B. Zeitfenster, Limiten, ML-Schwellen). Änderungen werden gespeichert und die News anschließend sofort neu geladen.</p>

        <h3>Update / Refresh</h3>
        <p>Artikel werden stündlich automatisch aktualisiert. Beim <strong>⟳ Neu laden</strong> (in den Einstellungen) wird die Konfiguration neu eingelesen und alles neu geladen.</p>

        <h3>Maschinelles Lernen &amp; dein Profil</h3>
        <p><strong>Konzept:</strong> NFM baut für dich ein kleines, persönliches KI-Modell, das aus deinem eigenen Klickverhalten lernt, was für dich interessant ist. Die Basis ist ein MiniLM-Sprachmodell, das Artikeltexte in Vektoren (sog. <em>semantic embeddings</em>) umwandelt — so kann die Ähnlichkeit verschiedener Artikel rechnerisch verglichen werden.</p>
        <p><strong>Trainingsdaten:</strong> Artikel, die du anklickst, dienen als <strong>Positiv-Beispiele</strong>; als „uninteressant“ markierte Artikel werden als <strong>Negativ-Beispiele</strong> berücksichtigt. Ein Klassifikator (Logistische Regression) lernt daraus die Grenze „ähnlich zu dem, was du magst“.</p>
        <p><strong>Wirkung:</strong> Artikel, denen die KI eine hohe Wahrscheinlichkeit für dein Interesse gibt, bekommen eine 💡-Markierung sowie ein Prozent-Badge mit der geschätzten Wahrscheinlichkeit.</p>
        <p><strong>Datenschutz:</strong> Das Modell bleibt pro Nutzer und lernt ausschließlich aus deinem eigenen Verhalten — es werden keine Daten zwischen Nutzern geteilt.</p>
        <ul>
          <li><strong>Hinweis zur Aktivierung:</strong> Ein Modell wird erst trainiert, wenn genügend Klicks + Markierungen gesammelt wurden (Schwellwert <em>ML_RETRAIN_THRESHOLD_BYTES</em>). Solange dieses Limit noch nicht erreicht ist, gibt es noch keine 💡-Vorhersagen — der 💡-Filter zeigt dann nichts.</li>
          <li><strong>Was gilt als Interesse (Positiv)?</strong> Ein Klick auf einen Artikel markiert ihn als gelesen (ausgegraut) und zählt als Positiv-Beispiel (automatisch 3 Sterne).<br>
          <strong>Stern-Bewertung:</strong> Neben jedem Artikel stehen 5 ausgegraute Sterne. Klicke auf einen Stern (z.&nbsp;B. den 3.), um den Artikel zu bewerten – gefüllt werden alle Sterne bis dahin. Je mehr Sterne du vergibst, desto stärker lernt die KI „so etwas mag ich“: Artikel, die hoch &nbsp;bewerteten Artikeln sämtlich ähnlich sind, bekommen eher die 💡-Markierung und erscheinen so im „Nur ähnliche Artikel“-Filter. Ein einfaches Anklicken setzt automatisch 3 Sterne.</li>
          <li><strong>Wie markiere ich „uninteressant“ (Negativ)?</strong> Es gibt keinen Einzel-Artikel-Button für „uninteressant“. Stattdessen findet sich je Abschnitt/Sektion der Button <strong>🗑️ Ungelesene ausblenden</strong>: Er erfasst alle noch ungeklickten Artikel dieses Abschnitts, blendet sie aus und speichert sie für das KI-Modell als Negativ-Beispiel. Die Markierung erfolgt also abschnitts-/sektionsweise.</li>
        </ul>
    </div>
  </div>

  {% if show_settings_ui %}
  <!-- ========== Settings Overlay ========== -->
  <div id="settings-overlay" class="settings-overlay" hidden>
    <div class="settings-panel">
      <div class="settings-header">
        <span>Einstellungen{% if data %} — {{ data["uid"] }}{% endif %}</span>
        <button type="button" class="settings-close" onclick="closeSettings();" title="Schließen">×</button>
      </div>
      <div id="settings-status"></div>
      <div id="settings-content">
        <p>Lade Einstellungen…</p>
      </div>
      <div class="settings-footer">
        <button type="button" class="btn" onclick="closeSettings();">Abbrechen</button>
        <button type="button" class="btn" id="settings-reload-btn" onclick="reloadApp();" title="Konfiguration neu einlesen und alle News neu laden">⟳ Neu laden</button>
        <button type="button" class="btn" id="settings-save-btn" onclick="saveSettings();">Speichern</button>
      </div>
    </div>
  </div>
  {% endif %}

</body>
</html>
